# docker compose settings — copy to .env and fill in. Never commit .env.
POSTGRES_DB=melodia
POSTGRES_USER=melodia
POSTGRES_PASSWORD=change-me
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
CORS_ORIGINS=*
WEB_CONCURRENCY=2
LYRICS_USER_AGENT=Melodia/1.0 (https://your-site.example)
# Only with docker-compose.cloudflare.yml: `cloudflared tunnel token <tunnel-name>`
CLOUDFLARE_TUNNEL_TOKEN=
# Music provider: audius (default) or gaana (then also run with --profile gaana)
MUSIC_PROVIDER=audius
