+
+def test_album_and_artist_rows_from_search_hits():
+    album = album_row_from_entity({"seo": "aashiqui-2", "id": 501, "ti": "Aashiqui 2",
+                                   "aw": "https://img/size_m_5.jpg", "sti": "Mithoon,Arijit Singh",
