+
+
+@pytest.mark.parametrize("entity", [
+    {"seokey": "x", "track_title": "X"},                         # no artwork
+    {"seokey": "x", "artwork": "https://img/size_s.jpg"},        # no title
+    {"track_title": "X", "artwork": "https://img/size_s.jpg"},   # no seokey
