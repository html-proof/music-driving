+# --- search ---------------------------------------------------------------------------
+
+@pytest.mark.asyncio
+async def test_song_search_rows_come_from_the_recorded_hits_in_one_request():
+    g = await gaana_answering(lambda url, kw: recorded("search_tracks_tum_hi_ho.json"))
+
+    rows = await g.search_songs("Tum Hi Ho", 10)
