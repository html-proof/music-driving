# Copy to .env (local dev) — never commit real values.

ENVIRONMENT=development
LOG_LEVEL=INFO

# PostgreSQL (psycopg 3 async driver)
DATABASE_URL=postgresql+psycopg://melodia:melodia@localhost:5432/melodia

# Redis (leave empty for an in-process cache; required with >1 worker/instance)
REDIS_URL=redis://localhost:6379/0

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-secret
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# Comma separated origins; mobile apps don't need CORS, browsers do.
CORS_ORIGINS=*

# GaanaPy service (see docker-compose.yml / third_party/GaanaPy)
GAANAPY_BASE_URL=http://localhost:8001
PROVIDER_TIMEOUT_SECONDS=30
# Gaana blocks bursts. When it refuses a request the backend stops calling it for this
# long (doubling on each repeat block, up to the max) and serves cached copies instead.
PROVIDER_BLOCK_COOLDOWN_SECONDS=60
PROVIDER_BLOCK_COOLDOWN_MAX_SECONDS=600
CATALOG_CACHE_TTL_SECONDS=900
# Home rows cost one Gaana request per song on refresh: keep them short and cached longer.
HOME_CACHE_TTL_SECONDS=3600
HOME_SECTION_SIZE=12
HOME_ARTIST_COUNT=4
VERIFY_STREAM_QUALITY=true
DEFAULT_LANGUAGES=English,Hindi

# Lyrics (LRCLIB)
LYRICS_ENABLED=true
LYRICS_BASE_URL=https://lrclib.net
LYRICS_USER_AGENT=Melodia/1.0 (self-hosted; set a contact URL here)
