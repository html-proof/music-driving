# Copy to .env (local dev) — never commit real values.

ENVIRONMENT=development
LOG_LEVEL=INFO

# PostgreSQL (psycopg 3 async driver)
DATABASE_URL=postgresql+psycopg://melodia:melodia@localhost:5432/melodia

# Redis (leave empty for an in-process cache; required with >1 worker/instance)
REDIS_URL=redis://localhost:6379/0

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-secret
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# Comma separated origins; mobile apps don't need CORS, browsers do.
CORS_ORIGINS=*

# Music provider: "gaana" is required for the Indian film / label and international
# catalogue (needs the GaanaPy service below). "audius" (the default) only has music
# uploaded to Audius by its artists.
MUSIC_PROVIDER=gaana

# GaanaPy service (see docker-compose.yml / third_party/GaanaPy)
GAANAPY_BASE_URL=http://localhost:8001
PROVIDER_TIMEOUT_SECONDS=30
# Gaana blocks bursts. When it refuses a request (GaanaPy answers 503 "blocked") the
# backend stops calling it for this long (at least GaanaPy's retry_after, doubling on each
# repeat block, up to the max) and serves cached copies instead.
PROVIDER_BLOCK_COOLDOWN_SECONDS=60
PROVIDER_BLOCK_COOLDOWN_MAX_SECONDS=600
CATALOG_CACHE_TTL_SECONDS=900
SEARCH_CACHE_TTL_SECONDS=300
# Each search section (songs, albums, artists, playlists) gets this long.
SEARCH_SECTION_TIMEOUT_SECONDS=10
# Home lists change slowly: cache them longer.
HOME_CACHE_TTL_SECONDS=3600
HOME_SECTION_SIZE=12
HOME_ARTIST_COUNT=4
# "Trending in <language>" rows: the user's languages first, then these (6 rows at most).
HOME_LANGUAGES=Hindi,Malayalam,Tamil,Telugu,Punjabi
# The "International hits" row.
INTERNATIONAL_LANGUAGE=English
# Deadline for each Home row; a late row falls back to its last good copy (marked stale).
HOME_SECTION_TIMEOUT_SECONDS=12
VERIFY_STREAM_QUALITY=true
DEFAULT_LANGUAGES=English,Hindi

# Lyrics (LRCLIB)
LYRICS_ENABLED=true
LYRICS_BASE_URL=https://lrclib.net
LYRICS_USER_AGENT=Melodia/1.0 (self-hosted; set a contact URL here)
